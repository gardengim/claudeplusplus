#!/bin/sh
# Before a push: unit tests, then the thesis budget (binary size, resting memory, first paint, idle CPU).
# No model calls, so it costs nothing. The contract check (bench/contract.py) calls the real claude and is run by hand.
# Skip once with:  git push --no-verify
set -e
cd "$(git rev-parse --show-toplevel)"
echo "pre-push: cargo test"
cargo test --quiet
echo "pre-push: budget"
cargo build --release --quiet
python3 bench/budget.py >/dev/null || { python3 bench/budget.py | tail -n 20; echo "pre-push: over budget (or no pty here: use --no-verify)"; exit 1; }
echo "pre-push: ok"
